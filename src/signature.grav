// signature.grav — a command's signature, as Laravel writes it, and reading a
// command line against it.
//
//   "mail:send {user : The user's id} {--Q|queue=default : The queue} {--force} {files?*}"
//
//   {name}  {name?}  {name=default}  {name*}  {name?*}         arguments
//   {--flag}  {--opt=}  {--opt=default}  {--opt=*}  {--S|opt=}  options
//   … : a description (after a colon)
//
// On the command line: --opt=value or --opt value, -S value or -Svalue, -abc
// (several flags), --no-flag (a flag off), and -- (everything after it is an
// argument). Unknown options and missing arguments are errors that say what
// was meant.
import "std"
import "apogee-support"

namespace apogee {

    class ArgumentSpec {
        public name: string
        public optional: bool = false
        public isArray: bool = false
        public fallback: string = ""
        public hasFallback: bool = false
        public description: string = ""
        constructor(name: string) { self.name = name; }
    }

    class OptionSpec {
        public name: string
        public shortcut: string = ""
        // Takes a value (--opt=…); otherwise a flag.
        public takesValue: bool = false
        public isArray: bool = false
        public fallback: string = ""
        public description: string = ""
        constructor(name: string) { self.name = name; }
    }

    // A command line didn't fit the signature.
    class ConsoleUsageException extends Exception {
        constructor(message: string) { super(message); }
        public fn kind() -> string { return "ConsoleUsageException"; }
    }

    class CommandSpec {
        public name: string = ""
        public arguments: Array<ArgumentSpec>
        public options: Array<OptionSpec>
        constructor() { self.arguments = new Array<ArgumentSpec>(); self.options = new Array<OptionSpec>(); }

        // Reads a signature; ValueError when it is malformed.
        static fn parse(signature: string) -> CommandSpec {
            let spec = new CommandSpec();
            let s = Str.trim(signature);
            let brace = Str.indexOf(s, "{");
            spec.name = Str.trim(brace < 0 ? s : s[..brace]);
            if (spec.name == "" || Str.contains(spec.name, " ")) { throw new ValueError("a command signature starts with its name: '" + signature + "'"); }
            let i = brace < 0 ? s.length : brace;
            while (i < s.length) {
                let open = Str.indexFrom(s, "{", i);
                if (open < 0) { break; }
                let close = Str.indexFrom(s, "}", open);
                if (close < 0) { throw new ValueError("an unclosed { in the signature '" + signature + "'"); }
                spec.addPart(Str.trim(s[open + 1..close]), signature);
                i = close + 1;
            }
            // (an optional argument cannot come before a required one; an array argument is last)
            let seenOptional = false;
            for (k, a in spec.arguments) {
                if (a.optional) { seenOptional = true; }
                else if (seenOptional) { throw new ValueError("the required argument '" + a.name + "' follows an optional one in '" + signature + "'"); }
                if (a.isArray && k != spec.arguments.size() - 1) { throw new ValueError("the array argument '" + a.name + "' must be the last in '" + signature + "'"); }
            }
            return spec;
        }
        private fn addPart(part: string, signature: string) {
            let body = part;
            let description = "";
            let colon = Str.indexOf(part, " : ");
            if (colon >= 0) { body = Str.trim(part[..colon]); description = Str.trim(part[colon + 3..]); }
            else if (Str.endsWith(Str.trim(part), ":")) { body = Str.trim(Str.trim(part)[..Str.trim(part).length - 1]); }
            if (Str.startsWith(body, "--")) {
                let o = new OptionSpec("");
                o.description = description;
                let rest = body[2..];
                let bar = Str.indexOf(rest, "|");
                if (bar >= 0) { o.shortcut = rest[..bar]; rest = rest[bar + 1..]; }
                let eq = Str.indexOf(rest, "=");
                if (eq >= 0) {
                    o.takesValue = true;
                    let value = rest[eq + 1..];
                    rest = rest[..eq];
                    if (value == "*") { o.isArray = true; }
                    else { o.fallback = value; }
                }
                o.name = Str.trim(rest);
                if (o.name == "") { throw new ValueError("an option without a name in '" + signature + "'"); }
                self.options.push(o);
                return;
            }
            let a = new ArgumentSpec("");
            a.description = description;
            let rest = body;
            let eq = Str.indexOf(rest, "=");
            if (eq >= 0) { a.fallback = rest[eq + 1..]; a.hasFallback = true; a.optional = true; rest = rest[..eq]; }
            if (Str.endsWith(rest, "*")) { a.isArray = true; rest = rest[..rest.length - 1]; }
            if (Str.endsWith(rest, "?")) { a.optional = true; rest = rest[..rest.length - 1]; }
            a.name = Str.trim(rest);
            if (a.name == "") { throw new ValueError("an argument without a name in '" + signature + "'"); }
            self.arguments.push(a);
        }
        fn option(name: string) -> OptionSpec {
            for (o in self.options) { if (o.name == name) { return o; } }
            return null;
        }
        fn optionByShortcut(s: string) -> OptionSpec {
            for (o in self.options) { if (o.shortcut == s) { return o; } }
            return null;
        }

        // Reads a command line (without the command's name) against this signature.
        fn read(tokens: Array<string>) -> ParsedInput {
            let input = new ParsedInput(self);
            let positional = new Array<string>();
            let onlyArgs = false;
            let i = 0;
            while (i < tokens.size()) {
                let t = tokens[i];
                i += 1;
                if (onlyArgs || t == "-" || !Str.startsWith(t, "-")) { positional.push(t); continue; }
                if (t == "--") { onlyArgs = true; continue; }
                if (Str.startsWith(t, "--")) {
                    let body = t[2..];
                    let eq = Str.indexOf(body, "=");
                    let name = eq >= 0 ? body[..eq] : body;
                    let o = self.option(name);
                    if (o == null && Str.startsWith(name, "no-") && eq < 0) {
                        let flag = self.option(name[3..]);
                        if (flag != null && !flag.takesValue) { input.setFlag(flag.name, false); continue; }
                    }
                    if (o == null) { throw new ConsoleUsageException("the option '--" + name + "' does not exist" + self.suggest(name)); }
                    if (!o.takesValue) {
                        if (eq >= 0) { throw new ConsoleUsageException("the '--" + name + "' option takes no value"); }
                        input.setFlag(o.name, true);
                        continue;
                    }
                    let value = "";
                    if (eq >= 0) { value = body[eq + 1..]; }
                    else if (i < tokens.size() && !Str.startsWith(tokens[i], "-")) { value = tokens[i]; i += 1; }
                    else if (o.fallback == "" && !o.isArray) { throw new ConsoleUsageException("the '--" + name + "' option needs a value"); }
                    else { value = o.fallback; }
                    input.setOption(o, value);
                    continue;
                }
                // -x, -xvalue, -abc
                let shorts = t[1..];
                let k = 0;
                while (k < shorts.length) {
                    let letter = shorts[k..k + 1];
                    let o = self.optionByShortcut(letter);
                    if (o == null) { throw new ConsoleUsageException("the option '-" + letter + "' does not exist"); }
                    k += 1;
                    if (!o.takesValue) { input.setFlag(o.name, true); continue; }
                    let value = shorts[k..];
                    if (value == "" && i < tokens.size() && !Str.startsWith(tokens[i], "-")) { value = tokens[i]; i += 1; }
                    if (value == "" && o.fallback == "") { throw new ConsoleUsageException("the '-" + letter + "' option needs a value"); }
                    input.setOption(o, value == "" ? o.fallback : value);
                    break;
                }
            }
            let p = 0;
            for (a in self.arguments) {
                if (a.isArray) {
                    let list = new Array<string>();
                    while (p < positional.size()) { list.push(positional[p]); p += 1; }
                    if (list.size() == 0 && !a.optional) { throw new ConsoleUsageException("not enough arguments (missing: \"" + a.name + "\")"); }
                    input.arrays.put(a.name, list);
                    continue;
                }
                if (p < positional.size()) { input.args.put(a.name, positional[p]); p += 1; }
                else if (!a.optional) { throw new ConsoleUsageException("not enough arguments (missing: \"" + self.missing(p) + "\")"); }
                else if (a.hasFallback) { input.args.put(a.name, a.fallback); }
            }
            if (p < positional.size()) {
                throw new ConsoleUsageException(self.arguments.size() == 0 ? "no arguments expected for \"" + self.name + "\", got \"" + positional[p] + "\""
                    : "too many arguments, expected: " + Str.join(self.argumentNames(), " "));
            }
            for (o in self.options) {
                if (o.takesValue && !o.isArray && !input.opts.containsKey(o.name) && o.fallback != "") { input.opts.put(o.name, o.fallback); }
            }
            return input;
        }
        private fn missing(from: int) -> string {
            let names = new Array<string>();
            for (k in from..self.arguments.size()) { if (!self.arguments[k].optional) { names.push(self.arguments[k].name); } }
            return Str.join(names, "\", \"");
        }
        fn argumentNames() -> Array<string> { let out = new Array<string>(); for (a in self.arguments) { out.push(a.name); } return out; }
        private fn suggest(name: string) -> string {
            let best = "";
            let bestD = 3;
            for (o in self.options) {
                let d = Str.levenshtein(name, o.name);
                if (d < bestD) { bestD = d; best = o.name; }
            }
            return best == "" ? "" : ". Did you mean --" + best + "?";
        }
        // "mail:send <user> [<files>...] [--queue QUEUE] [--force]".
        fn synopsis() -> string {
            let parts = new Array<string>();
            parts.push(self.name);
            if (self.options.size() > 0) { parts.push("[options]"); }
            for (a in self.arguments) {
                let n = "<" + a.name + ">" + (a.isArray ? "..." : "");
                parts.push(a.optional ? "[" + n + "]" : n);
            }
            return Str.join(parts, " ");
        }
    }

    // A command line read against a signature.
    class ParsedInput {
        public spec: CommandSpec
        public args: HashMap<string, string>
        public arrays: HashMap<string, Array<string>>
        public opts: HashMap<string, string>
        public optArrays: HashMap<string, Array<string>>
        public flags: HashMap<string, bool>
        constructor(spec: CommandSpec) {
            self.spec = spec;
            self.args = new HashMap<string, string>();
            self.arrays = new HashMap<string, Array<string>>();
            self.opts = new HashMap<string, string>();
            self.optArrays = new HashMap<string, Array<string>>();
            self.flags = new HashMap<string, bool>();
        }
        fn setFlag(name: string, on: bool) { self.flags.put(name, on); }
        fn setOption(o: OptionSpec, value: string) {
            if (o.isArray) {
                let list = self.optArrays.getOr(o.name, null);
                if (list == null) { list = new Array<string>(); self.optArrays.put(o.name, list); }
                list.push(value);
            } else { self.opts.put(o.name, value); }
        }
    }
}
